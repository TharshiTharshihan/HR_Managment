PORT=5000
# Frontend origin(s) allowed by CORS, comma-separated (no trailing slash)
CLIENT_URL=https://your-app.vercel.app
FIREBASE_PROJECT_ID=hr-portal-604a1
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@hr-portal.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=hr-portal-604a1.firebasestorage.app

# Used only by scripts/migrate-postgres-to-firebase.js
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hr_portal
DB_USER=postgres
DB_PASSWORD=
# Time zone for birthday reminders (default Asia/Colombo)
BIRTHDAY_TIMEZONE=Asia/Colombo
# Company code at the start of payslip numbers, e.g. 999DI4821 (default 999)
PAYSLIP_COMPANY_CODE=999
# Free Gemini API key from https://aistudio.google.com/apikey (HR AI assistant)
GEMINI_API_KEY=
# Optional: main and fallback models (defaults gemini-3.5-flash, gemini-flash-lite-latest)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
